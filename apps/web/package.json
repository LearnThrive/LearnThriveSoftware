{
  "name": "@learnthrive/web",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "predev": "node ../../scripts/dev-services.mjs",
    "dev": "tsx server.ts",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:e2e": "playwright test",
    "test:prod-smoke": "playwright test -c playwright.prod.config.ts",
    "library:import": "node --import tsx scripts/library-import.mjs",
    "library:grant": "node --import tsx scripts/library-grant.mjs",
    "billing:reconcile": "node --import tsx scripts/billing-reconcile.mjs",
    "assistant:retention": "node --import tsx scripts/assistant-retention.mjs",
    "research:check": "node scripts/research-check.mjs",
    "assistant:bench": "node --import tsx scripts/assistant-bench.mjs",
    "paper:bench": "node --import tsx scripts/paper-bench.mjs",
    "documents:check": "node --import tsx scripts/document-check.mjs",
    "voice:dev": "uv run --project ../../services/voice python ../../services/voice/server.py",
    "voice:bench": "node --import tsx scripts/voice-bench.mjs",
    "profile:motion": "node scripts/profile-motion.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:realstack": "node scripts/realstack.mjs",
    "check:env": "node scripts/check-env.mjs",
    "env:docs": "node scripts/env-docs.mjs --write",
    "check:bundle": "node scripts/check-bundle.mjs",
    "supabase:verify": "node scripts/supabase-verify.mjs",
    "db:create-server-role": "node scripts/create-server-role.mjs",
    "db:promote-admin": "node scripts/promote-admin.mjs",
    "supabase:smoke": "node --import tsx scripts/supabase-smoke.mjs",
    "env:template": "node scripts/env-docs.mjs --template",
    "ollama:bench": "node --import tsx scripts/ollama-bench.mjs",
    "ollama:local": "node ../../scripts/ollama-local.mjs",
    "ollama:photo-check": "node --import tsx scripts/ollama-photo-check.mjs",
    "ollama:lifecycle": "node --import tsx scripts/ollama-lifecycle-check.mjs",
    "ollama:browser-check": "node scripts/ollama-browser-check.mjs",
    "paper:live": "node --import tsx scripts/paper-live-check.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@fullcalendar/core": "6.1.19",
    "@fullcalendar/daygrid": "6.1.19",
    "@fullcalendar/interaction": "6.1.19",
    "@fullcalendar/list": "6.1.19",
    "@fullcalendar/react": "6.1.19",
    "@fullcalendar/timegrid": "6.1.19",
    "@learnthrive/data": "*",
    "@learnthrive/realtime": "*",
    "@learnthrive/shared": "*",
    "@napi-rs/canvas": "0.1.84",
    "@pdf-lib/fontkit": "1.1.1",
    "framer-motion": "^13.4.4",
    "jpeg-js": "0.4.4",
    "katex": "0.19.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.47.0",
    "mathjax-full": "3.2.2",
    "next": "16.3.8",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.394",
    "pngjs": "7.0.0",
    "postgres": "3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "6.28.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@types/katex": "0.16.8",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.13.0",
    "eslint-config-next": "16.3.2",
    "playwright-core": "1.62.1",
    "storybook": "^10.6.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  }
}
