# Optional: exact hostname printed by cloudflared, without https:// or a path.
# TUNNEL_HOST=example-random-name.trycloudflare.com

# Optional TURN relay. Browser VITE_ values are public; use short-lived credentials.
# Comma-separated URLs are supported, e.g. turn:relay.example.com:3478,turns:relay.example.com:5349
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
